#!/bin/bash
# Builds Hidden: Source's Linux client, server and shader libraries in the Steam Runtime (sniper)
# container, like buildallprojects does for /hl2mp /tf. Outside the container it re-runs itself in
# one with podman; inside (CI, or a sniper shell) it builds directly.
#
#   ./buildhidden [debug|release]

set -euo pipefail

script=$(readlink -f -- "$0")
pushd "$(dirname -- "$script")" > /dev/null

if [[ -z "${HIDDEN_IN_SNIPER:-}" ]]; then
    source sdk_container
    run_in_sniper "$@"
fi

mode="${1:-release}"
if [[ "$mode" != "debug" && "$mode" != "release" ]]; then
    echo "Usage: $0 [debug|release]"
    exit 1
fi
export VPC_NINJA_BUILD_MODE="$mode"

solution_out="_vpc_/ninja/hidden_$VPC_NINJA_BUILD_MODE"

if [[ ! -e "$solution_out.ninja" ]]; then
    devtools/bin/vpc /hidden /linux64 /ninja /define:SOURCESDK +game +game_shader_generic_hidden /mksln "$solution_out"
fi

ninja -f "$solution_out.ninja" -j"$(nproc)"

# The dedicated server loads server_srv.so, built with /dedicated: it links the dedicated server's
# libtier0_srv.so and libvstdlib_srv.so and the _srv static libraries, and loads _srv modules.
# tier1 and mathlib build from source; for the libraries the SDK only has prebuilt, link the client
# ones under their _srv names (none has a soname, so the name is what server_srv.so asks for).
libdir=lib/public/linux64
for lib in libtier0.so libvstdlib.so choreoobjects.a dmxloader.a particles.a tier2.a tier3.a; do
    cp -u "$libdir/$lib" "$libdir/${lib%.*}_srv.${lib##*.}"
done

dedicated_out="_vpc_/ninja/hidden_dedicated_$VPC_NINJA_BUILD_MODE"

if [[ ! -e "$dedicated_out.ninja" ]]; then
    devtools/bin/vpc /hidden /linux64 /ninja /define:SOURCESDK /dedicated +server +tier1 +mathlib /mksln "$dedicated_out"
fi

ninja -f "$dedicated_out.ninja" -j"$(nproc)"

# The 64-bit launcher SteamCMD's dedicated server lacks (srcds_hidden/srcds_main.cpp).
g++ -O2 -Wall -o ../game/srcds_linux64 srcds_hidden/srcds_main.cpp -ldl

popd
